    "root": "specs",
    "active_pattern": "specs/active/SPEC-NNN",
    "markdown_name": "SPEC.md",
    "execution_name": "SPEC.execution.json"
  },
  "validation": [
    {
      "id": "VAL-001",
      "command": "python scripts/harness/project_map.py check --project-root .",
      "required": true
    },
    {
      "id": "VAL-002",
      "command": "python skills/project-harness-auditor/scripts/audit_project_harness.py --project-root .",
      "required": true
    },
    {
      "id": "VAL-003",
      "command": "git diff --check",
      "required": true
    }
  ],
  "runtime_policy": {
    "policy_version": "1.0",
    "project_path": ".codex/references/runtime-policy.json"
  },
  "thread_policy": {
    "design": "current explicitly approved task",
    "implementation": "sequential current working tree",
    "needs_design": "persist consequential decisions before continuing",
    "parallel_writes": "sequential_by_default",
    "subagents": "not_default"
  },
  "automatic_handoff": false
