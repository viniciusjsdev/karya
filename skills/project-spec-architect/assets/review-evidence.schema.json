{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Harness independent review evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_id", "contract_version", "status", "thread_id", "runtime", "review_input", "baseline_assessment", "findings", "evidence", "usage"],
  "properties": {
    "spec_id": {"type": "string", "pattern": "^SPEC-[0-9]{3,}$"},
    "contract_version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["approved", "changes_requested", "blocked", "failed"]},
    "thread_id": {"type": ["string", "null"]},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["classification", "model", "reasoning"], "properties": {"classification": {"type": "string", "const": "critical_review"}, "model": {"type": "string"}, "reasoning": {"type": "string"}}},
    "review_input": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "baseline_assessment": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["category", "result", "evidence", "notes"], "properties": {"category": {"type": "string", "enum": ["tests", "cli", "json_contracts", "persistence", "schemas", "protected_paths", "decisions"]}, "result": {"type": "string", "enum": ["preserved", "changed_as_approved", "regressed", "not-applicable"]}, "evidence": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "array", "items": {"type": "string"}}}}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "usage": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["input_tokens", "cached_input_tokens", "cache_write_input_tokens", "output_tokens", "reasoning_output_tokens"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "cached_input_tokens": {"type": "integer", "minimum": 0}, "cache_write_input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "reasoning_output_tokens": {"type": "integer", "minimum": 0}}}]}
  }
}
