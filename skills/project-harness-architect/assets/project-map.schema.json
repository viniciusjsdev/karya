{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Karya project navigation map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "nodes",
    "relations",
    "maintenance"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "objective"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "summary",
          "path",
          "target",
          "status",
          "authority",
          "fingerprint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "domain",
              "product",
              "architecture",
              "decision",
              "contract",
              "code",
              "validation",
              "workflow",
              "reference",
              "operation",
              "spec",
              "runtime",
              "data",
              "methodology",
              "other"
            ]
          },
          "summary": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "enum": [
              "file",
              "directory",
              "pattern",
              "external"
            ]
          },
          "status": {
            "enum": [
              "existing",
              "planned"
            ]
          },
          "authority": {
            "enum": [
              "primary",
              "supporting",
              "external"
            ]
          },
          "fingerprint": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "type",
          "rationale"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "contains",
              "references",
              "governed_by",
              "implements",
              "validates",
              "depends_on",
              "supersedes"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_at",
        "review_note",
        "map_fingerprint",
        "project_fingerprint"
      ],
      "properties": {
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_note": {
          "type": "string"
        },
        "map_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "areas"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "areas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "rationale",
              "sources",
              "members"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "members": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
