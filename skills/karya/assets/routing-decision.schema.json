{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karya.local/schemas/karya-routing-decision.schema.json",
  "title": "Karya Routing Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "request_summary",
    "classification",
    "recommended_route",
    "runtime_recommendation",
    "economic_execution",
    "coordination",
    "supporting_routes",
    "open_questions",
    "approval",
    "automatic_handoff"
  ],
  "properties": {
    "$schema": { "const": "./routing-decision.schema.json" },
    "schema_version": { "const": "1.2" },
    "decision_id": { "type": "string", "minLength": 1 },
    "request_summary": { "type": "string", "minLength": 1 },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_intent", "project_state", "cost_preference", "confidence", "signals"],
      "properties": {
        "primary_intent": {
          "enum": ["direct_execution", "product_work", "market_research", "commercial_work", "project_harness", "mixed", "unclear"]
        },
        "project_state": { "type": "string", "minLength": 1 },
        "cost_preference": { "enum": ["unspecified", "economize_codex", "lowest_safe_cost", "codex_preferred"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "signals": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "recommended_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "factory", "entry_skill", "reason", "approved_scope", "planned_skills"],
      "properties": {
        "mode": { "enum": ["direct", "factory"] },
        "factory": {
          "type": ["string", "null"],
          "enum": [null, "MVP Factory", "Research Factory", "Marketing Factory", "Project Harness Factory"]
        },
        "entry_skill": { "type": ["string", "null"] },
        "reason": { "type": "string", "minLength": 1 },
        "approved_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "planned_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skill", "purpose", "when"],
            "properties": {
              "skill": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "when": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "runtime_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "phase", "model", "reasoning", "rationale", "downshift_condition", "audit"],
      "properties": {
        "status": { "enum": ["advisory", "materialized"] },
        "phase": { "enum": ["bootstrap_design", "resolved_implementation", "mechanical_change", "critical_risk_or_review"] },
        "model": { "enum": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"] },
        "reasoning": { "enum": ["low", "medium", "high"] },
        "rationale": { "type": "string", "minLength": 1 },
        "downshift_condition": { "type": ["string", "null"] },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "capability", "when"],
          "properties": {
            "required": { "type": "boolean" },
            "capability": { "type": ["string", "null"] },
            "when": { "type": ["string", "null"] }
          }
        }
      }
    },
    "economic_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "status", "recommended_executor", "reason", "provider_options", "requires_action_confirmation", "fallback", "assumptions"],
      "properties": {
        "eligible": { "type": "boolean" },
        "status": { "enum": ["not_applicable", "advisory"] },
        "recommended_executor": { "type": ["string", "null"], "enum": [null, "opencode"] },
        "reason": { "type": "string", "minLength": 1 },
        "provider_options": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "requires_action_confirmation": { "const": true },
        "fallback": { "const": "codex" },
        "assumptions": { "const": "none" }
      }
    },
    "coordination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinator", "user_facing_interface", "execution_mode", "active_skill"],
      "properties": {
        "coordinator": { "const": "karya" },
        "user_facing_interface": { "const": "karya" },
        "execution_mode": { "const": "same_thread_by_default" },
        "active_skill": { "type": ["string", "null"] }
      }
    },
    "supporting_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factory", "entry_skill", "reason", "when", "requires_additional_approval", "automatic_handoff"],
        "properties": {
          "factory": { "enum": ["MVP Factory", "Research Factory", "Marketing Factory", "Project Harness Factory"] },
          "entry_skill": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "requires_additional_approval": { "const": true },
          "automatic_handoff": { "const": false }
        }
      }
    },
    "not_recommended": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "open_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "question"],
      "properties": {
        "required": { "const": true },
        "status": { "enum": ["pending", "approved", "rejected", "revised"] },
        "question": { "type": "string", "minLength": 1 }
      }
    },
    "automatic_handoff": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "recommended_route": { "properties": { "mode": { "const": "direct" } } } } },
      "then": {
        "properties": {
          "recommended_route": {
            "properties": {
              "factory": { "type": "null" },
              "entry_skill": { "type": "null" },
              "planned_skills": { "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "recommended_route": { "properties": { "mode": { "const": "factory" } } } } },
      "then": {
        "properties": {
          "recommended_route": {
            "properties": {
              "factory": { "type": "string" },
              "entry_skill": { "type": "string", "minLength": 1 },
              "planned_skills": { "minItems": 1 }
            }
          }
        }
      }
    }
  ]
}
