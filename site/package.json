{
  "name": "karya-official-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "sync:brand": "node scripts/sync-brand-assets.mjs",
    "dev": "node scripts/sync-brand-assets.mjs && node scripts/build-project-map.mjs && vite",
    "build": "node scripts/sync-brand-assets.mjs && node scripts/build-project-map.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "security:lockfile": "node scripts/check-lockfile.mjs",
    "security:scripts": "node scripts/check-install-scripts.mjs",
    "security:signatures": "npm audit signatures",
    "security:audit": "npm audit --audit-level=high",
    "security:sbom": "npm sbom --sbom-format=cyclonedx"
  },
  "dependencies": {
    "@xyflow/react": "12.11.5",
    "framer-motion": "13.1.0",
    "lucide-react": "0.544.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "autoprefixer": "10.4.21",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.26",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
